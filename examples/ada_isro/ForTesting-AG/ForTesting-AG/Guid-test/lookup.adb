	procedure Output_Lookup (Distance_Current : in float32; Quaternion_Out : out Math.Quaternion) is

	    AngleIncr               : float32;
	    Quaternion_Incr         : Math.Quaternion;
	    Present : boolean;
	
	  begin
	
	    -- If index outside valid range, retain previous values of commands
	  
		if (Distance_Current < Distance(1) or else Distance_Current > Distance(60)) then
		  Quaternion_Out := Quaternion_Prev;
	
		else
	
	          Present := False;
	
	          while not(Present) loop
	
	            if ((Distance_Current >= Distance(IterationCount)) and then (Distance_Current < Distance(IterationCount+1))) then
	            
	               -- Compute increments
	            
	               AngleIncr := RotAngle(IterationCount) * Distance_Incr;
	               
	               Quaternion_Incr(1) := Library.Cosine(AngleIncr);	               
	               Quaternion_Incr(2) := DirCosL(IterationCount) * Library.Sine(AngleIncr);
	               Quaternion_Incr(3) := DirCosM(IterationCount) * Library.Sine(AngleIncr);
	               Quaternion_Incr(4) := DirCosN(IterationCount) * Library.Sine(AngleIncr);
	
	               Math.Normalise(Quaternion_Incr);
	
	               Math.Multiply(Quaternion_Prev, Quaternion_Incr, Quaternion_Out);
	               
	               Present := True;
	
	             else
	             
	               -- Modify index
	             
	               if (Distance_Current < Distance(IterationCount)) then
	                      IterationCount := IterationCount-1;
	               else
	                      IterationCount := IterationCount+1;
	               end if;
	               
	               Distance_Incr := Distance_Current - Distance(IterationCount);
	               
	               Quaternion_Prev(1)  := CmdQuaternion1(IterationCount);
	               Quaternion_Prev(2)  := CmdQuaternion2(IterationCount);
	               Quaternion_Prev(3)  := CmdQuaternion3(IterationCount);
	               Quaternion_Prev(4)  := CmdQuaternion4(IterationCount);
	               
	            end if;
	
	          end loop;
	
	      -- Update previous values    
	          
		  Quaternion_Prev := Quaternion_Out;
	
		end if;
	
    end Output_Lookup;

end Lookup;
