--This program accepts an input date from the user and prints out the--corresponding day. The program demonstrates the use of a Case stmt--with text_io; use text_io;procedure day is   mm,dd,yy,month,year : short_integer;   cent,offset,n : short_integer;begin   put("* case statement demonstration *");   new_line;   new_line;   put("enter the date as DD MM YYYY");   new_line;   get(dd);   get(mm);   get(yy);   new_line;  -- dd := 16;  -- mm := 11;   --yy := 2002;   case mm is      when 1 | 2 =>          month := mm + 10;          year := yy - 1;      when others =>          month :=  mm - 2;          year := yy;   end case;   cent := year / 100;--   offset := year mod 100;   offset := year rem 100;   n := (13 * month - 1) / 5 + dd + offset + offset / 4 + cent / 4;   n := n - 2 * cent + 77;   n := n - 7 * (n / 7);   put("the day is ");   case n is      when 0 => put("sunday");      when 1 => put("monday");      when 2 => put("tuesday");      when 3 => put("wednesday");      when 4 => put("thursday");      when 5 => put("friday");      when 6 => put("saturday");      when others => null;   end case;   new_line;end day;