---- This program solves the problem of Towers of hanoi. Demonstration of -- Recursion and if stmt    procedure HANOI is       N : short_integer;   PROCEDURE HANO(N,A,B,C : in short_integer) is      BEGIN        IF (N > 1) THEN            HANO(N-1,A,C,B);         end if;         put("MOVE DISK");         put(N);         put("  FROM POLE");         put(A);         put("   TO POLE");         put(B);         new_line;         IF (N > 1) THEN            HANO(N-1,C,B,A);         end if;      END HANO;   BEGIN      put("* DEMONSTRATION OF RECURSION *");new_line;      put("*      TOWERS OF HANOI       *");new_line;      new_line;      put("ENTER NO OF DISKS ON POLE 1");new_line;      get(N);      HANO(N,1,2,3);   END hanoi;