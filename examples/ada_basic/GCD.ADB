--The program finds the greatest common divisor of 2 input integers and prints--the result.Demonstration of function and procedure calls, recursion and--if/else stmts procedure Gcd is      function Gcd1(M,N : in Short_Integer) return Short_Integer is   begin      if N = 0 then         return(M);      else--         return(Gcd1(N, M mod N));         return(Gcd1(N, M rem N));      end if;   end Gcd1;   procedure Try(A,B : in Short_Integer) is   begin      Put(A);Put(" ");Put(B); Put(" ");      Put(Gcd1(A,B));      New_Line;   end Try;begin   Try(18,27);   Try(312,2142);   Try(61,53);   Try(98,868);end Gcd;